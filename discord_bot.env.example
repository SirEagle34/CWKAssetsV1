# Copy these values into PythonAnywhere environment variables or a private .env file.
# NEVER commit a real bot token.
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token

# Absolute path to the SQLite database used by app.py.
# Example only: /home/YOUR_PYTHONANYWHERE_USERNAME/path/to/instance/cardwarskingdom.db
CWK_DATABASE_PATH=/absolute/path/to/cardwarskingdom.db

# Optional public URL that returns HTTP 2xx/3xx when app.py is healthy.
# Use an existing harmless endpoint; do not expose admin or private routes.
CWK_HEALTH_URL=https://your-domain.example/health

# Optional: faster slash-command registration for one test Discord server.
DISCORD_GUILD_ID=

# Optional channel IDs.
DISCORD_ANNOUNCE_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=

# Presence refresh interval, minimum 60 seconds.
DISCORD_STATUS_INTERVAL=300
LOG_LEVEL=INFO
