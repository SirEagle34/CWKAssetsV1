# ===================================
# Unity .gitignore
# ===================================

# Unity folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Explicit project-root ignores (requested)
/Library/
/Temp/
/.builtapk

# Visual Studio cache/options directory
.vs/

# Gradle cache directory (for Android builds)
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# ===================================
# OS generated files
# ===================================

# Windows
Thumbs.db
Thumbs.db.meta
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*

# ===================================
# Project specific
# ===================================

# Log files
UpgradeLog.htm

# Translation work files (opcional - descomenta si no quieres subirlos)
# PENDING_ARABIC_TRANSLATION.txt
# COMPLETED_ARABIC.txt
# TRADUCCIONES_APLICADAS.txt

# Herramientas de desarrollo (no commitear ejecutables grandes)
Tools/ffmpeg.exe

# Loose Temp Assets
Assets/StreamingAssets/Windows/ffmpeg.exe
Assets/PlayFabEditorExtensions/Editor/Resources/PlayFabEditorPrefsSO.asset
Assets/PlayFabEditorExtensions/Editor/Resources/PlayFabEditorPrefsSO.asset.meta
Assets/Plugins/Android/local.properties.meta
Assets/Resources/creatures/drghostbear.meta
Assets/Resources/creatures/sackgeist.meta
Assets/Resources/ui/icons_creatures/Creature_DrGhostBear.png.meta
Assets/Resources/ui/icons_creatures/Creature_Sackgeist.png.meta
Assets/Scripts/Assembly-CSharp/APFlowerWhenFortifyDEF.cs.meta
Assets/Scripts/Assembly-CSharp/BraveryFortifyRESOnOppFloop.cs.meta
Assets/Scripts/Assembly-CSharp/OnFriendlyFortifyDEF.cs.meta
Assets/PlayFabEditorExtensions/Editor/Resources/PlayFabEditorPrefsSO.asset
Assets/PlayFabEditorExtensions/Editor/Resources/PlayFabEditorPrefsSO.asset.meta
Assets/Plugins/Android/local.properties.meta
ProjectSettings/UnityConnectSettings.asset
